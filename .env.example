# Supabase → Project Settings → API (или Connect)
VITE_SUPABASE_URL=https://your-project.supabase.co
# Только публичный ключ: anon / publishable (sb_publishable_...).
# service_role / secret ключ сюда НЕЛЬЗЯ: всё, что начинается с VITE_, попадает в бандл.
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Необязательно: пароль демо-пользователей. Если задан, на экране входа появятся кнопки быстрого входа.
# Не задавайте его для рабочей системы с настоящими данными.
VITE_DEMO_PASSWORD=
